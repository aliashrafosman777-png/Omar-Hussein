# Omar Hussein Photography — Environment Variables
# Copy this file to .env.local and fill in the values.

# Contact Form Email Provider
# Set to "resend" to enable email delivery via Resend.
# Leave empty only when intentionally disabling email delivery in development.
CONTACT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender must use a domain verified in Resend.
RESEND_FROM_EMAIL="Omar Hussein Photography <hello@oh-omarhussein.com>"
# Inbox that receives new contact and course notifications.
CONTACT_TO_EMAIL=
# Address used when a client replies to an email sent by the website.
RESEND_REPLY_TO_EMAIL=

# Admin Authentication
# The email address used to log in to the admin dashboard.
ADMIN_EMAIL=
# Optional deployment-friendly bcrypt hash. If omitted, the app falls back to
# data/admin-hash.txt. Escape each $ as \$ when using an unquoted .env value.
ADMIN_PASSWORD_HASH=
# Secret key for signing session JWTs (min 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Persistent production storage for submissions and admin-managed work images.
# Create a private Vercel Blob store connected to this project; Vercel adds
# BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=

# Admin password hash is stored in data/admin-hash.txt (not in .env).
# Generate with: node scripts/hash-password.mjs "your-password"
